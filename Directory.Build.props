<Project>
  <PropertyGroup>
    <!-- Overridden by CI from the release tag. Jellyfin requires a 4-part version. -->
    <Version>0.1.0.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <Authors>Eli Samuel Sanchez</Authors>
    <Company>jellyfin-plugin-interest-collections</Company>
    <Product>Jellyfin Interest Collections</Product>
    <Copyright>Copyright (c) 2026 Eli Samuel Sanchez</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/elisamuel40/jellyfin-plugin-interest-collections</RepositoryUrl>

    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
</Project>
